.venv/
__pycache__/
*.py[cod]
.env
.pytest_cache/
.ruff_cache/

# CDK
infra/cdk.out/
infra/.cdk.staging/

# Eval output is a build artifact; datasets are checked in, results are not.
evals/results/

# Downloaded benchmark corpus (~60MB). Reproduce with:
#   python -m evals.datasets.fetch_enterprise_bench
evals/corpus/

# Chainlit regenerates its translation bundle on every run — config.toml is the
# only part worth version control.
.chainlit/translations/
.files/

# draw.io writes a lock/backup file next to any diagram it has open. One got
# committed in 0.4.0 — it is 55KB of duplicate XML that conflicts on every edit.
.$*.drawio.bkp
*.drawio.bkp
*.drawio.dtmp
