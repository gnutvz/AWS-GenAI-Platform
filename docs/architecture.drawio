          <mxGeometry x="370" y="70" width="150" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Retrieve&#10;hybrid · top-6 · ≥0.35" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;" vertex="1" parent="rband">
          <mxGeometry x="570" y="20" width="160" height="52" as="geometry" />
        </mxCell>
