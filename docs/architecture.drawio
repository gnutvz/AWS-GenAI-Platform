  <diagram name="2. Ingest" id="page-ingest">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="it" value="Ingest pipeline — what happens to a document" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="it2" value="Runs in a container, not Lambda: docling downloads model weights and exceeds both the package limit and the timeout." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="1 · Source&#xa;&#xa;PDF, DOCX, PPTX, XLSX, MD, TXT" style="rounded=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="2 · Parse to Markdown&#xa;&#xa;docling — keeps tables and heading structure" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i2n" value="Bedrock can ingest a raw PDF, but its extraction flattens tables — and in enterprise documents the table often IS the answer. Parsing is the one part of RAG worth owning." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="3 · Metadata gate&#xa;&#xa;require_metadata from tenant config" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i3r" value="REJECTED&#xa;missing effective_date / version" style="rounded=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="340" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i3n" value="You cannot promise &quot;the right version&quot; when the source has no version control. Better to refuse the document than to answer confidently from a superseded revision." style="text;html=1;fontSize=10;fontColor=#B85450;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="590" y="335" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="4 · Store&#xa;&#xa;S3 + &lt;file&gt;.metadata.json sidecar" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i4n" value="Sidecar written now even though filtered retrieval is not used yet — adding it later means a full re-index." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i5" value="5 · Chunk&#xa;&#xa;hierarchical · parent 1500 / child 300 · overlap 60" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i5n" value="Children matched for precision, parents returned for context. Fixed-size chunking forces a choice between the two; this costs more storage instead." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="550" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i6" value="6 · Embed&#xa;&#xa;Titan Text Embeddings v2 · 1024 dims" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i6n" value="Per-tenant choice. Changing it means re-indexing that tenant — which is possible only because knowledge bases are not shared." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="660" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i7" value="7 · Index&#xa;&#xa;S3 Vectors · cosine · one index per tenant" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i7n" value="S3 Vectors rather than OpenSearch Serverless: no standing OCU floor, so an idle tenant costs cents. This is what makes one-knowledge-base-per-tenant affordable at all." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="770" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i8" value="8 · Sync&#xa;&#xa;Bedrock StartIngestionJob → queryable" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ie1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i1" target="i2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i2" target="i3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#B85450;" edge="1" parent="1" source="i3" target="i3r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i3" target="i4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i4" target="i5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i5" target="i6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i6" target="i7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i7" target="i8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iscale" value="AT SCALE" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="380" height="480" as="geometry" />
        </mxCell>
        <mxCell id="is1" value="Event-driven — S3 upload triggers ingest instead of a manual run" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="50" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is2" value="Orchestration — Step Functions or Airflow: profile, validate, sync, verify" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="115" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is3" value="Incremental — only changed documents re-embedded" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="180" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is4" value="Extraction — pull effective_date and version out of the document itself" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="245" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is5" value="Quality gate — reject a sync that drops recall on the tenant&#39;s eval set" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="310" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is6" value="Lineage — every answer traceable to a source file and its revision" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="375" width="340" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. Agent runtime" id="page-runtime">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rt" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;" value="Agent runtime — one question, step by step" vertex="1">
          <mxGeometry height="30" width="700" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="rt2" parent="1" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" value="Deliberately one agent with one retrieval tool — no planner, no worker fleet. Both target use cases are: find, answer with sources, defer when unsure." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" value="1 · Request arrives" vertex="1">
          <mxGeometry height="50" width="220" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s1n" parent="1" style="text;html=1;fontSize=10;fontColor=#333333;align=left;" value="SigV4-signed. A public LLM endpoint is an invitation to run up someone else&#39;s model bill." vertex="1">
          <mxGeometry height="40" width="330" x="300" y="115" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" value="2 · Resolve tenant → knowledge base" vertex="1">
          <mxGeometry height="50" width="220" x="60" y="185" as="geometry" />
        </mxCell>
        <mxCell id="s2n" parent="1" style="text;html=1;fontSize=10;fontColor=#333333;align=left;" value="The Lambda&#39;s IAM role names exactly one knowledge base ARN. Reaching another tenant is not a bug that can be written." vertex="1">
          <mxGeometry height="40" width="330" x="300" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=12;" value="3 · Load conversation state" vertex="1">
          <mxGeometry height="50" width="220" x="60" y="260" as="geometry" />
        </mxCell>
        <mxCell id="s3n" parent="1" style="text;html=1;fontSize=10;fontColor=#333333;align=left;" value="S3 session state, 30-day expiry. Compute stays stateless, so the same agent survives a cold start or a move to another runtime." vertex="1">
          <mxGeometry height="40" width="330" x="300" y="265" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="4 · Model decides: retrieve or answer" vertex="1">
          <mxGeometry height="50" width="220" x="60" y="335" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=12;" value="5 · Retrieve&#xa;hybrid search, top-6, score ≥ 0.35" vertex="1">
          <mxGeometry height="60" width="220" x="60" y="410" as="geometry" />
        </mxCell>
        <mxCell id="s5n" parent="1" style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" value="Hybrid, not pure semantic: exact identifiers — part numbers, error codes, revisions — are most of what enterprise users search for, and vectors alone miss them. Low-scoring passages are dropped rather than padded into context." vertex="1">
          <mxGeometry height="70" width="330" x="300" y="410" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="6 · Assemble prompt&#xa;system + passages + history" vertex="1">
          <mxGeometry height="60" width="220" x="60" y="500" as="geometry" />
        </mxCell>
        <mxCell id="s6n" parent="1" style="text;html=1;fontSize=10;fontColor=#333333;align=left;" value="Prompt caching on the stable prefix — it pays for itself as soon as the system prompt carries a tool catalogue." vertex="1">
          <mxGeometry height="40" width="330" x="300" y="505" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=12;" value="7 · Generate&#xa;Bedrock" vertex="1">
          <mxGeometry height="60" width="220" x="60" y="590" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=12;" value="8 · Guardrail" vertex="1">
          <mxGeometry height="60" width="220" x="60" y="680" as="geometry" />
        </mxCell>
        <mxCell id="s8n" parent="1" style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" value="Three things at once: content filters, PII anonymised rather than blocked (a masked phone number still answers the question), and contextual grounding — a score for whether the answer is actually supported by the passages. That last one is a hallucination control with a number attached, which is what an auditor asks for." vertex="1">
          <mxGeometry height="90" width="330" x="300" y="675" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" value="9 · Answer with [n] citations" vertex="1">
          <mxGeometry height="50" width="220" x="60" y="770" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" value="9b · Refuse — say so plainly" vertex="1">
          <mxGeometry height="50" width="220" x="60" y="840" as="geometry" />
        </mxCell>
        <mxCell id="s10n" parent="1" style="text;html=1;fontSize=10;fontColor=#B85450;align=left;verticalAlign=top;" value="Scored by the eval suite as refusal accuracy. An agent that scores well on answerable questions while inventing answers to unanswerable ones is worse than no agent at all." vertex="1">
          <mxGeometry height="60" width="330" x="300" y="835" as="geometry" />
        </mxCell>
        <mxCell id="s11" parent="1" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="10 · Emit trace&#xa;OTel span per model and tool call" vertex="1">
          <mxGeometry height="60" width="220" x="60" y="910" as="geometry" />
        </mxCell>
        <mxCell id="se1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se4" edge="1" parent="1" source="s4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se5" edge="1" parent="1" source="s5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se6" edge="1" parent="1" source="s6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se7" edge="1" parent="1" source="s7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se8" edge="1" parent="1" source="s8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" target="s9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se9" edge="1" parent="1" source="s8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#D79B00;" target="s10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se10" edge="1" parent="1" source="s9" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82B366;dashed=1;" target="s11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seloop" edge="1" parent="1" source="s5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82B366;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" target="s4" value="loop until done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rscale" parent="1" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fontColor=#666666;" value="AT SCALE — added in this order" vertex="1">
          <mxGeometry height="790" width="760" x="680" y="110" as="geometry" />
        </mxCell>
        <mxCell id="rs1" parent="rscale" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="1 · Streaming and long sessions — move to AgentCore Runtime. Same build_agent(), different entrypoint. Stack, execution role and per-tenant image repository all exist: cdk deploy -c agentcore=true. Never run against a live account." vertex="1">
          <mxGeometry height="60" width="720" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="rs2" parent="rscale" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="2 · Reranking — a cross-encoder over the top 20 before handing 6 to the model. The cheapest quality win once retrieval is the bottleneck rather than generation." vertex="1">
          <mxGeometry height="60" width="720" x="20" y="125" as="geometry" />
        </mxCell>
        <mxCell id="rs3" parent="rscale" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="3 · Query rewriting — expand abbreviations and part-number formats before searching. Matters most for the exact-identifier lookups hybrid search already targets." vertex="1">
          <mxGeometry height="60" width="720" x="20" y="200" as="geometry" />
        </mxCell>
        <mxCell id="rs4" parent="rscale" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="4 · Human-in-the-loop — route low-grounding answers to a reviewer, and feed the correction back into the eval set. Closes the loop that makes quality improve rather than drift." vertex="1">
          <mxGeometry height="60" width="720" x="20" y="275" as="geometry" />
        </mxCell>
        <mxCell id="rs5" parent="rscale" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="5 · Long-term memory — what this user asked before, what was corrected. Distinct from conversation state, and only useful once there are repeat users." vertex="1">
          <mxGeometry height="60" width="720" x="20" y="350" as="geometry" />
        </mxCell>
        <mxCell id="rs6" parent="rscale" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="6 · Model routing — cheap model for classification and judging, strong model for answering. Needs the gateway; the seam is already in aiplat/llm.py." vertex="1">
          <mxGeometry height="60" width="720" x="20" y="425" as="geometry" />
        </mxCell>
        <mxCell id="rs7" parent="rscale" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="7 · Online evaluation — score a sample of live traffic, not just the offline set. Catches the drift an offline suite cannot see." vertex="1">
          <mxGeometry height="60" width="720" x="20" y="500" as="geometry" />
        </mxCell>
        <mxCell id="rs8" parent="rscale" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#B85450;" value="8 · Multi-agent — ONLY when a use case genuinely needs parallel independent work. Both current use cases do not; a planner added now would be scaffolding for imaginary requirements." vertex="1">
          <mxGeometry height="65" width="720" x="20" y="575" as="geometry" />
        </mxCell>
        <mxCell id="rsnote" parent="rscale" style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=top;" value="Ordered by cost-to-value, not by how impressive it looks on a slide. Items 2 and 4 move the numbers a buyer asks about; item 8 usually does not." vertex="1">
          <mxGeometry height="50" width="720" x="20" y="660" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. Now vs at scale" id="page-matrix">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mt" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;" value="Every component — what it is now, what it becomes" vertex="1">
          <mxGeometry height="30" width="800" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="mt2" parent="1" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" value="&quot;Now&quot; means built, tested and running in CI. &quot;At scale&quot; means designed for but deliberately not built — the seam exists so it stays a config or deployment change." vertex="1">
          <mxGeometry height="20" width="1100" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="h1" parent="1" style="rounded=0;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" value="COMPONENT" vertex="1">
          <mxGeometry height="36" width="220" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="h2" parent="1" style="rounded=0;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" value="NOW" vertex="1">
          <mxGeometry height="36" width="460" x="260" y="90" as="geometry" />
        </mxCell>
        <mxCell id="h3" parent="1" style="rounded=0;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" value="AT SCALE" vertex="1">
          <mxGeometry height="36" width="460" x="720" y="90" as="geometry" />
        </mxCell>
        <mxCell id="h4" parent="1" style="rounded=0;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" value="WHAT TRIGGERS THE CHANGE" vertex="1">
          <mxGeometry height="36" width="480" x="1180" y="90" as="geometry" />
        </mxCell>
        <mxCell id="c1a" parent="1" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" value="Ingest" vertex="1">
          <mxGeometry height="60" width="220" x="40" y="126" as="geometry" />
        </mxCell>
        <mxCell id="c1b" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="docling in a container, run by hand" vertex="1">
          <mxGeometry height="60" width="460" x="260" y="126" as="geometry" />
        </mxCell>
        <mxCell id="c1c" parent="1" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="S3 event → Step Functions → incremental re-embed" vertex="1">
          <mxGeometry height="60" width="460" x="720" y="126" as="geometry" />
        </mxCell>
        <mxCell id="c1d" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="Documents change more than weekly" vertex="1">
          <mxGeometry height="60" width="480" x="1180" y="126" as="geometry" />
        </mxCell>
        <mxCell id="c2a" parent="1" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" value="Retrieval" vertex="1">
          <mxGeometry height="60" width="220" x="40" y="186" as="geometry" />
        </mxCell>
        <mxCell id="c2b" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="Bedrock KB, hybrid, top-6, min score 0.35" vertex="1">
          <mxGeometry height="60" width="460" x="260" y="186" as="geometry" />
        </mxCell>
        <mxCell id="c2c" parent="1" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="+ rerank, + query rewriting (metadata filters built)" vertex="1">
          <mxGeometry height="60" width="460" x="720" y="186" as="geometry" />
        </mxCell>
        <mxCell id="c2d" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="Context recall/precision measure this now, instead of leaving it to judgement" vertex="1">
          <mxGeometry height="60" width="480" x="1180" y="186" as="geometry" />
        </mxCell>
        <mxCell id="c3a" parent="1" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" value="Vector store" vertex="1">
          <mxGeometry height="60" width="220" x="40" y="246" as="geometry" />
        </mxCell>
        <mxCell id="c3b" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="S3 Vectors — idle cost near zero" vertex="1">
          <mxGeometry height="60" width="460" x="260" y="246" as="geometry" />
        </mxCell>
        <mxCell id="c3c" parent="1" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="OpenSearch Serverless for hot tenants only" vertex="1">
          <mxGeometry height="60" width="460" x="720" y="246" as="geometry" />
        </mxCell>
        <mxCell id="c3d" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="Sustained QPS where latency beats standing cost" vertex="1">
          <mxGeometry height="60" width="480" x="1180" y="246" as="geometry" />
        </mxCell>
        <mxCell id="c4a" parent="1" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" value="Memory" vertex="1">
          <mxGeometry height="60" width="220" x="40" y="306" as="geometry" />
        </mxCell>
        <mxCell id="c4b" parent="1" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="Conversation state in S3, 30-day expiry" vertex="1">
          <mxGeometry height="60" width="460" x="260" y="306" as="geometry" />
        </mxCell>
        <mxCell id="c4c" parent="1" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" value="Long-term memory — prior questions, corrections" vertex="1">
