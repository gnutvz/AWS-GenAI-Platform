        </mxCell>
        <mxCell id="lg4" value="Later phase" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1540" y="35" width="105" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="Per tenant = its own knowledge base, its own Lambda, its own IAM role." style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="1215" y="64" width="440" height="18" as="geometry" />
        </mxCell>

        <mxCell id="wband" value="WRITE PATH — runs on demand, not in the request" style="swimlane;startSize=30;fillColor=none;strokeColor=#B3B3B3;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1620" height="170" as="geometry" />
