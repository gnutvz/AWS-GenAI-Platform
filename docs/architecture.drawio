        <mxCell id="kb" value="KNOWLEDGE BASE — one per tenant" style="swimlane;startSize=30;fillColor=#E8F4FB;strokeColor=#4D9FD6;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="kb1" value="tenant: acme&#10;kb-acme · index-acme" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;" vertex="1" parent="kb">
          <mxGeometry x="30" y="50" width="220" height="46" as="geometry" />
        </mxCell>
        <mxCell id="kb2" value="tenant: globex&#10;kb-globex · index-globex" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;" vertex="1" parent="kb">
          <mxGeometry x="280" y="50" width="220" height="46" as="geometry" />
        </mxCell>
        <mxCell id="kb3" value="tenant: n …" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;" vertex="1" parent="kb">
          <mxGeometry x="530" y="50" width="150" height="46" as="geometry" />
        </mxCell>
        <mxCell id="kbnote" value="Separate knowledge bases, not a shared index with a tenant filter. Cross-tenant retrieval is then a permission you do not hold, rather than a filter someone can forget. Also lets each tenant pick its own embedding model — which matters as soon as one corpus is Japanese and another is Vietnamese." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="kb">
          <mxGeometry x="710" y="44" width="870" height="56" as="geometry" />
        </mxCell>

        <mxCell id="rband" value="READ PATH — one request" style="swimlane;startSize=30;fillColor=none;strokeColor=#B3B3B3;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="1620" height="290" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="Client&#10;CLI · UI · API" style="rounded=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;" vertex="1" parent="rband">
          <mxGeometry x="30" y="70" width="130" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Function URL&#10;IAM · SigV4" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;" vertex="1" parent="rband">
          <mxGeometry x="200" y="70" width="130" height="56" as="geometry" />
        </mxCell>
