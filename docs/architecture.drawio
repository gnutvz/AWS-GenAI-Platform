          <mxGeometry x="790" y="70" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r8" value="Guardrail&#10;PII · content · grounding" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;" vertex="1" parent="rband">
          <mxGeometry x="1010" y="70" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r9" value="Answer&#10;with [n] citations" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="rband">
          <mxGeometry x="1240" y="40" width="150" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r10" value="&quot;I don't know&quot;&#10;no supporting source" style="rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="rband">
          <mxGeometry x="1240" y="108" width="150" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r11" value="Escalate to a human&#10;not built" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;" vertex="1" parent="rband">
          <mxGeometry x="1440" y="108" width="150" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rnote" value="Refusal is a first-class outcome, not a failure. It is the behaviour buyers ask about and the one the eval suite scores." style="text;html=1;fontSize=10;fontColor=#B85450;align=left;" vertex="1" parent="rband">
          <mxGeometry x="1230" y="168" width="360" height="30" as="geometry" />
        </mxCell>

