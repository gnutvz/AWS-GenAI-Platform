        <mxCell id="kbnote" parent="kb" style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" value="Separate knowledge bases, not a shared index with a tenant filter. Cross-tenant retrieval is then a permission you do not hold, rather than a filter someone can forget. Also lets each tenant pick its own embedding model — which matters as soon as one corpus is Japanese and another is Vietnamese." vertex="1">
          <mxGeometry height="56" width="870" x="710" y="44" as="geometry" />
        </mxCell>
        <mxCell id="rband" parent="1" style="swimlane;startSize=30;fillColor=none;strokeColor=#B3B3B3;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" value="READ PATH — one request" vertex="1">
          <mxGeometry height="290" width="1620" x="40" y="450" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="rband" style="rounded=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;" value="Client&#xa;CLI · API" vertex="1">
