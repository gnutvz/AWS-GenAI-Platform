        <mxCell id="kb" parent="1" style="swimlane;startSize=30;fillColor=#E8F4FB;strokeColor=#4D9FD6;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" value="KNOWLEDGE BASE — one per tenant" vertex="1">
