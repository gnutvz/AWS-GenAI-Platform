  <diagram name="2. Ingest" id="page-ingest">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="it" value="Ingest pipeline — what happens to a document" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="it2" value="Runs in a container, not Lambda: docling downloads model weights and exceeds both the package limit and the timeout." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="i1" value="1 · Source&#10;&#10;PDF, DOCX, PPTX, XLSX, MD, TXT" style="rounded=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="2 · Parse to Markdown&#10;&#10;docling — keeps tables and heading structure" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i2n" value="Bedrock can ingest a raw PDF, but its extraction flattens tables — and in enterprise documents the table often IS the answer. Parsing is the one part of RAG worth owning." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="i3" value="3 · Metadata gate&#10;&#10;require_metadata from tenant config" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i3r" value="REJECTED&#10;missing effective_date / version" style="rounded=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="340" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i3n" value="You cannot promise &quot;the right version&quot; when the source has no version control. Better to refuse the document than to answer confidently from a superseded revision." style="text;html=1;fontSize=10;fontColor=#B85450;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="590" y="335" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="i4" value="4 · Store&#10;&#10;S3 + &lt;file&gt;.metadata.json sidecar" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i4n" value="Sidecar written now even though filtered retrieval is not used yet — adding it later means a full re-index." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i5" value="5 · Chunk&#10;&#10;hierarchical · parent 1500 / child 300 · overlap 60" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i5n" value="Children matched for precision, parents returned for context. Fixed-size chunking forces a choice between the two; this costs more storage instead." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="550" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i6" value="6 · Embed&#10;&#10;Titan Text Embeddings v2 · 1024 dims" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i6n" value="Per-tenant choice. Changing it means re-indexing that tenant — which is possible only because knowledge bases are not shared." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="660" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i7" value="7 · Index&#10;&#10;S3 Vectors · cosine · one index per tenant" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i7n" value="S3 Vectors rather than OpenSearch Serverless: no standing OCU floor, so an idle tenant costs cents. This is what makes one-knowledge-base-per-tenant affordable at all." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="770" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="i8" value="8 · Sync&#10;&#10;Bedrock StartIngestionJob → queryable" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ie1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#B85450;" edge="1" parent="1" source="i3" target="i3r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i5" target="i6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i6" target="i7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="i7" target="i8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="iscale" value="AT SCALE" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="380" height="480" as="geometry" />
        </mxCell>
        <mxCell id="is1" value="Event-driven — S3 upload triggers ingest instead of a manual run" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="50" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is2" value="Orchestration — Step Functions or Airflow: profile, validate, sync, verify" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="115" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is3" value="Incremental — only changed documents re-embedded" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="180" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is4" value="Extraction — pull effective_date and version out of the document itself" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="245" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is5" value="Quality gate — reject a sync that drops recall on the tenant's eval set" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="310" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="is6" value="Lineage — every answer traceable to a source file and its revision" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="iscale">
          <mxGeometry x="20" y="375" width="340" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3. Agent runtime" id="page-runtime">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="rt" value="Agent runtime — one question, step by step" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rt2" value="Deliberately one agent with one retrieval tool — no planner, no worker fleet. Both target use cases are: find, answer with sources, defer when unsure." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="1 · Request arrives" style="rounded=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1n" value="SigV4-signed. A public LLM endpoint is an invitation to run up someone else's model bill." style="text;html=1;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="300" y="115" width="330" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="2 · Resolve tenant → knowledge base" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2n" value="The Lambda's IAM role names exactly one knowledge base ARN. Reaching another tenant is not a bug that can be written." style="text;html=1;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="300" y="190" width="330" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="3 · Load conversation state" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3n" value="S3 session state, 30-day expiry. Compute stays stateless, so the same agent survives a cold start or a move to another runtime." style="text;html=1;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="300" y="265" width="330" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="4 · Model decides: retrieve or answer" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="335" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="5 · Retrieve&#10;hybrid search, top-6, score ≥ 0.35" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5n" value="Hybrid, not pure semantic: exact identifiers — part numbers, error codes, revisions — are most of what enterprise users search for, and vectors alone miss them. Low-scoring passages are dropped rather than padded into context." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="410" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="6 · Assemble prompt&#10;system + passages + history" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6n" value="Prompt caching on the stable prefix — it pays for itself as soon as the system prompt carries a tool catalogue." style="text;html=1;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="300" y="505" width="330" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="7 · Generate&#10;Bedrock" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="8 · Guardrail" style="rounded=1;fillColor=#D5E8F7;strokeColor=#4D9FD6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s8n" value="Three things at once: content filters, PII anonymised rather than blocked (a masked phone number still answers the question), and contextual grounding — a score for whether the answer is actually supported by the passages. That last one is a hallucination control with a number attached, which is what an auditor asks for." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="675" width="330" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="9 · Answer with [n] citations" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="9b · Refuse — say so plainly" style="rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s10n" value="Scored by the eval suite as refusal accuracy. An agent that scores well on answerable questions while inventing answers to unanswerable ones is worse than no agent at all." style="text;html=1;fontSize=10;fontColor=#B85450;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="835" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s11" value="10 · Emit trace&#10;OTel span per model and tool call" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se9" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#D79B00;" edge="1" parent="1" source="s8" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se10" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82B366;dashed=1;" edge="1" parent="1" source="s9" target="s11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="seloop" value="loop until done" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82B366;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="s5" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="rscale" value="AT SCALE — added in this order" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="680" y="110" width="760" height="790" as="geometry" />
        </mxCell>
        <mxCell id="rs1" value="1 · Streaming and long sessions — move to AgentCore Runtime. Same build_agent(), different entrypoint; the image already exists." style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="50" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rs2" value="2 · Reranking — a cross-encoder over the top 20 before handing 6 to the model. The cheapest quality win once retrieval is the bottleneck rather than generation." style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="125" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rs3" value="3 · Query rewriting — expand abbreviations and part-number formats before searching. Matters most for the exact-identifier lookups hybrid search already targets." style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="200" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rs4" value="4 · Human-in-the-loop — route low-grounding answers to a reviewer, and feed the correction back into the eval set. Closes the loop that makes quality improve rather than drift." style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="275" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rs5" value="5 · Long-term memory — what this user asked before, what was corrected. Distinct from conversation state, and only useful once there are repeat users." style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="350" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rs6" value="6 · Model routing — cheap model for classification and judging, strong model for answering. Needs the gateway; the seam is already in aiplat/llm.py." style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="425" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rs7" value="7 · Online evaluation — score a sample of live traffic, not just the offline set. Catches the drift an offline suite cannot see." style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="500" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rs8" value="8 · Multi-agent — ONLY when a use case genuinely needs parallel independent work. Both current use cases do not; a planner added now would be scaffolding for imaginary requirements." style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#B85450;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="575" width="720" height="65" as="geometry" />
        </mxCell>
        <mxCell id="rsnote" value="Ordered by cost-to-value, not by how impressive it looks on a slide. Items 2 and 4 move the numbers a buyer asks about; item 8 usually does not." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=top;" vertex="1" parent="rscale">
          <mxGeometry x="20" y="660" width="720" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="4. Now vs at scale" id="page-matrix">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="mt" value="Every component — what it is now, what it becomes" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt2" value="&quot;Now&quot; means built, tested and running in CI. &quot;At scale&quot; means designed for but deliberately not built — the seam exists so it stays a config or deployment change." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="h1" value="COMPONENT" style="rounded=0;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="NOW" style="rounded=0;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="460" height="36" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="AT SCALE" style="rounded=0;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="90" width="460" height="36" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="WHAT TRIGGERS THE CHANGE" style="rounded=0;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="90" width="480" height="36" as="geometry" />
        </mxCell>

        <mxCell id="c1a" value="Ingest" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="126" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c1b" value="docling in a container, run by hand" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="126" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c1c" value="S3 event → Step Functions → incremental re-embed" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="126" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c1d" value="Documents change more than weekly" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="126" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c2a" value="Retrieval" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c2b" value="Bedrock KB, hybrid, top-6, min score 0.35" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="186" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c2c" value="+ rerank, + query rewriting, + metadata filters" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="186" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c2d" value="Eval shows recall, not generation, is the ceiling" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="186" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c3a" value="Vector store" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c3b" value="S3 Vectors — idle cost near zero" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="246" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c3c" value="OpenSearch Serverless for hot tenants only" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="246" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c3d" value="Sustained QPS where latency beats standing cost" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="246" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c4a" value="Memory" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c4b" value="Conversation state in S3, 30-day expiry" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="306" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c4c" value="Long-term memory — prior questions, corrections" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="306" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c4d" value="Repeat users — meaningless for a demo" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="306" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c5a" value="LLM" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c5b" value="Bedrock direct, prompt caching on" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="366" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c5c" value="Gateway: per-team budgets, virtual keys, tiering" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="366" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c5d" value="More than one team shares the spend" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="366" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c6a" value="Guardrail" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="426" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c6b" value="Bedrock Guardrail: content, PII, grounding 0.75" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="426" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c6c" value="+ domain classifier, + automated reasoning checks" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="426" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c6d" value="Regulated domain, or an incident review" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="426" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c7a" value="Evaluation" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c7b" value="Offline: fact recall, refusal accuracy, citation rate" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="486" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c7c" value="CI gate + online sampling + drift alerts" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="486" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c7d" value="First production traffic — this is the earliest one" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1180" y="486" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c8a" value="Observability" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="546" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c8b" value="OTLP → Langfuse, local or Fargate" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="546" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c8c" value="Same OTLP, any backend; cost split per tenant" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="546" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c8d" value="Someone has to be billed for the tokens" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="546" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c9a" value="Tenancy" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c9b" value="One YAML per tenant → own KB, Lambda, IAM role" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="606" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c9c" value="Self-service provisioning from a pipeline" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="606" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c9d" value="Onboarding a tenant stops being a person's job" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="606" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c10a" value="End-user authz" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="666" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c10b" value="None — IAM protects the endpoint, not the rows" style="rounded=0;fillColor=#FFF4F4;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="260" y="666" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c10c" value="OIDC identity propagated into retrieval filters" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="666" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c10d" value="Any corpus where user A must not see user B's docs" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1180" y="666" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c11a" value="Orchestration" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="726" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c11b" value="One agent, one retrieval tool" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="726" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c11c" value="Planner + workers + tool registry" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="726" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c11d" value="A use case with genuinely parallel independent work — not before" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1180" y="726" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="c12a" value="Runtime" style="rounded=0;fillColor=#F0F0F0;strokeColor=#CCCCCC;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="c12b" value="Lambda — zero idle cost, 15 min cap, no streaming" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="260" y="786" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c12c" value="AgentCore Runtime — image already builds" style="rounded=0;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="786" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="c12d" value="Users want to see tokens appear as they are written" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1180" y="786" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="mnote" value="The column that matters is the last one. Every row on the right is cheap to reach because the seam already exists — and expensive to retrofit if it does not. That is the entire reason for building the boundaries before the features." style="text;html=1;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1620" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
