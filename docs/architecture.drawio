          <mxGeometry x="570" y="84" width="160" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="Rerank&#10;not built" style="rounded=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;" vertex="1" parent="rband">
          <mxGeometry x="570" y="148" width="160" height="52" as="geometry" />
