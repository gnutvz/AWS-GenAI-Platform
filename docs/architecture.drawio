          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Solid = built and tested today.   Dashed = deliberately not built yet (see page 4)." style="text;html=1;fontSize=12;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="" style="rounded=0;fillColor=none;strokeColor=#CCCCCC;dashed=0;" vertex="1" parent="1">
