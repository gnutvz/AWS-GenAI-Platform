        <mxCell id="wnote" value="Rejected here rather than indexed: a datasheet with no effective date can never be answered from safely." style="text;html=1;fontSize=10;fontColor=#B85450;align=center;" vertex="1" parent="wband">
          <mxGeometry x="360" y="124" width="260" height="30" as="geometry" />
