        </mxCell>
        <mxCell id="r1b" parent="rband" style="rounded=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" value="Chat UI — Chainlit&#xa;local only" vertex="1">
          <mxGeometry height="52" width="130" x="30" y="175" as="geometry" />
        </mxCell>
        <mxCell id="r1note" parent="rband" style="text;html=1;fontSize=10;fontColor=#B85450;align=left;" value="The UI does not cross the Function URL — it imports build_agent and runs in-process on local credentials. Fine on a laptop; deploying it as-is would put an unauthenticated agent in front of the tenant&#39;s knowledge base." vertex="1">
          <mxGeometry height="46" width="330" x="30" y="231" as="geometry" />
        </mxCell>
