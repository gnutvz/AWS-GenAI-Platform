# ============================================================================
# HANDOVER CONFIG — everything the application needs from AWS, in one file.
#
# FOR WHOEVER SETS UP AWS
#   You deploy; the person receiving this file only runs the application. So
#   every value it needs has to come back in here — they have no console access
#   and cannot look anything up.
#
#   1. Deploy:  cd infra && npx cdk bootstrap && cd .. && make deploy
#   2. Fill in every REPLACE_ME below. Each one says exactly where to get it.
#   3. Send this file back through a SECRETS channel, not email or chat — it
#      will contain live credentials.
#
# FOR WHOEVER RECEIVES IT
#   Save it as `.env` in the repository root. Nothing else to do:
#
#       cp handover.env .env
#       make ask Q="test question"
#
#   `.env` is git-ignored. Do not rename it to anything else — a file called
#   handover.env sitting in the repo is a credential waiting to be committed.
#
# SHORTCUT: if the person receiving this ends up with AWS access after all,
# `make env TENANT=<slug>` regenerates the whole file from the deployed stacks
# and none of this filling-in is necessary.
# ============================================================================


# --- 1 · Credentials --------------------------------------------------------
# How the application authenticates to AWS. It reads these directly; there is no
# other credential path.
#
# PREFERRED — SSO or an assumable role. Leave the keys below blank, have the
# recipient run `aws configure sso`, and send the start URL separately. Nothing
# secret then travels in this file at all.
#
# OTHERWISE — an access key for a principal that can call Bedrock, read the
# documents bucket and read/write the session bucket. Least privilege: it does
# NOT need permission to deploy anything.

AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Only for temporary credentials from STS / SSO. Leave blank for a long-lived
# key. Note these expire — hours, usually — and the application will start
# failing with an auth error when they do.
AWS_SESSION_TOKEN=

# Must be the region everything was deployed into.
AWS_REGION=REPLACE_ME


# --- 2 · Which tenant this machine talks to ---------------------------------
# One deployment per tenant; this file points at exactly one of them. Send a
# separate copy per tenant if the recipient needs more than one.
#
# The slug from tenants/<slug>.yaml.
TENANT=REPLACE_ME


# --- 3 · Resources created by the deploy ------------------------------------
# All of these are CloudFormation outputs. The fastest way to read them all:
#
#   aws cloudformation describe-stacks --region <region> \
#     --stack-name AiPlat-Knowledge-<tenant> \
#     --query "Stacks[0].Outputs" --output table
#
# Repeat for AiPlat-Api-<tenant> and AiPlat-Safety.

# Stack AiPlat-Knowledge-<tenant>, output KnowledgeBaseId.
# Without it the agent answers with no retrieval and cites nothing.
KNOWLEDGE_BASE_ID=REPLACE_ME

# Stack AiPlat-Knowledge-<tenant>, output DocumentsBucketName.
# Only needed on a machine that ingests documents.
DOCUMENTS_BUCKET=REPLACE_ME

# Stack AiPlat-Api-<tenant>, output SessionBucketName.
# Without it conversations do not persist between turns.
SESSION_BUCKET=REPLACE_ME

# Stack AiPlat-Api-<tenant>, output AgentFunctionUrl.
# Only needed for `make ask`, which calls the deployed agent rather than running
# one locally.
AGENT_FUNCTION_URL=REPLACE_ME


# --- 4 · Safety -------------------------------------------------------------
# Stack AiPlat-Safety, outputs GuardrailIdOutput and GuardrailVersionOutput.
#
# Leaving these blank is valid and means the agent runs with NO guardrail: no
# PII masking, no grounding check, no prompt-attack filter. Fill them in unless
# that is a deliberate decision.
GUARDRAIL_ID=REPLACE_ME
GUARDRAIL_VERSION=REPLACE_ME


# --- 5 · Model --------------------------------------------------------------
# Must be enabled in Bedrock model access for this account and region, or every
# question fails with AccessDeniedException while the deploy looks fine.
#
#   aws bedrock list-inference-profiles --region <region>
#
# Leave blank to use the value baked into the tenant's deployment.
MODEL_ID=

# Which prompt this tenant answers with. Both are set by the tenant's YAML at
# deploy time — fill them in only to override locally.
PROMPT_NAME=
PROMPT_VERSION=


# --- 6 · Optional ----------------------------------------------------------
# Everything below is off unless filled in. None of it is needed to run.

# Tracing. Only if the observability stack was deployed (it is opt-in and has a
# standing cost). ENDPOINT is the OtlpEndpoint output; HEADERS is created by
# hand after making a project in the Langfuse UI:
#   Authorization=Basic <base64 of "public_key:secret_key">
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Turns figures in documents into searchable text during ingest.
#   off | ocr | vlm     — vlm is one model call per figure, so it costs.
FIGURE_PROCESSOR=off

# Also treat clusters of lines and fills as figures. Inference rather than
# extraction; leave blank until a sample corpus has been checked.
DETECT_VECTOR_FIGURES=

# Route model calls through a LiteLLM proxy instead of Bedrock directly. Leave
# as-is unless one was deployed. Note: the gateway does not enforce Bedrock
# guardrails, so the application refuses to start with both this and
# GUARDRAIL_ID set unless GATEWAY_ALLOW_UNGUARDED is also set.
LLM_ROUTE=bedrock
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_ALLOW_UNGUARDED=
