# ============================================================================
# AWS handover config
#
# This is the same block as Step 7 of docs/setup-guide.pdf, as a file you can
# edit rather than retype. Fill it in and send it back.
#
# The person receiving it saves it as `.env` in the repository root and runs the
# tool locally. They deploy nothing and need no AWS console access.
#
# ⚠️  If you fill in the access-key lines, this file contains a live credential.
#     Send it through a password manager or vault — not email, not chat.
#     `.env` and `handover.env` are both git-ignored.
# ============================================================================


# --- Region ----------------------------------------------------------------
# The region every resource below was created in.
AWS_REGION=


# --- Credentials -----------------------------------------------------------
# Two options — use one, delete the other.
#
# OPTION A — SSO or an assumable role (preferred; nothing secret travels here).
#   Leave the two keys below blank and send these separately instead:
#     SSO start URL ...........
#     Account id ..............
#     Role / permission set ...
#
# OPTION B — an access key for a principal carrying the policy from Step 6 of
#   the guide. It needs no permission to create or delete anything.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only for temporary credentials from STS or SSO. They expire — usually within
# hours — and the tool starts failing with an auth error when they do.
AWS_SESSION_TOKEN=


# --- Resources -------------------------------------------------------------
# Guide Step 3. The short id shown on the Knowledge Base page, e.g. ABCD1234EF.
# Without it the tool answers from the model alone and cites nothing.
KNOWLEDGE_BASE_ID=

# Guide Step 2. Bucket name only — no s3:// prefix, no trailing path.
# Documents are expected under a `documents/` prefix inside it.
DOCUMENTS_BUCKET=

# Guide Step 5. Leave blank if that bucket was not created; conversations then
# do not carry over between questions, which is a working configuration.
SESSION_BUCKET=


# --- Safety ----------------------------------------------------------------
# Guide Step 4. Leave both blank if the guardrail was skipped — that is a valid
# choice and means answers carry no PII masking and no grounding check.
GUARDRAIL_ID=
GUARDRAIL_VERSION=


# --- Model -----------------------------------------------------------------
# Guide Step 1 — whichever Claude model was enabled. Must be exactly as Bedrock
# reports it, e.g.
#   global.anthropic.claude-sonnet-4-6
#   global.anthropic.claude-sonnet-5
#
# Leave blank to accept the tool's built-in default, which only works if that
# model happens to be one of the enabled ones.
MODEL_ID=


# --- Anything else worth passing on ----------------------------------------
# Free text. Data-residency rules, the Knowledge bases per account quota, who to
# contact if a permission turns out to be missing.
#
# NOTES=
