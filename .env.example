# Copy to .env and fill in. Everything has a working default except AWS credentials.

AWS_REGION=us-west-2

# --- Model routing -----------------------------------------------------------
# bedrock : call Bedrock directly. Fewer moving parts, native Guardrails. Default.
# gateway : call a LiteLLM proxy instead. Turn on when you need per-team budgets,
#           virtual API keys, or non-Bedrock models. App code does not change.
LLM_ROUTE=bedrock

# Options — see docs/aws-requirements.md §2. Whichever you pick must be enabled
# in Bedrock model access first, and confirmed available in your region.
#   global.anthropic.claude-haiku-4-5     cheap, high volume
#   global.anthropic.claude-sonnet-4-6    balanced (default)
#   global.anthropic.claude-sonnet-5      newer, promo pricing to 2026-08-31
#   global.anthropic.claude-opus-4-8      hardest reasoning, most expensive
MODEL_ID=global.anthropic.claude-sonnet-4-6

# Which system prompt version to run, from services/agent/prompts/system/.
# Empty means the highest file on disk, which is right for development. Pin it
# (2, or v2) anywhere the prompt should not change just because someone added a
# file. The version is reported on every answer and stamped on every trace.
PROMPT_VERSION=

# How figures inside ingested documents become searchable text. Read by the
# ingest container only.
#   off : figures are not indexed. A diagram in a document is invisible to the
#         agent — which was the silent behaviour before this setting existed.
#   ocr : read text printed inside the figure. Local and free; says nothing
#         about a diagram whose meaning is in its structure.
#   vlm : describe the figure with MODEL_ID above. Best recall, and one model
#         call per figure — on a 5,000-document corpus that is a real bill.
FIGURE_PROCESSOR=off

# Only read when LLM_ROUTE=gateway. Start the proxy with:
#   docker compose --profile gateway up -d
# With the gateway, MODEL_ID must be a `model_name` from gateway/litellm-config.yaml
# (e.g. platform-default), NOT a Bedrock inference-profile ID.
GATEWAY_BASE_URL=http://localhost:4000
GATEWAY_API_KEY=
LITELLM_MASTER_KEY=sk-local-dev-only

# Bedrock Guardrails bind to the Bedrock model, not to the proxy — so routing
# through the gateway means GUARDRAIL_ID below is configured but never applied.
# Setting both is refused at startup unless you set this, which asserts that
# enforcement lives in the gateway instead. Leave it off unless that is true.
GATEWAY_ALLOW_UNGUARDED=

# --- Safety ------------------------------------------------------------------
# Created by the guardrail stack. Leave empty to run without a guardrail.
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# --- Knowledge ---------------------------------------------------------------
# Output of the knowledge stack.
KNOWLEDGE_BASE_ID=
DOCUMENTS_BUCKET=

# --- Deployed endpoint --------------------------------------------------------
# Output of the api stack. Used by scripts/ask.py, which SigV4-signs each call
# because the Function URL is IAM-authenticated.
AGENT_FUNCTION_URL=

# --- State -------------------------------------------------------------------
# Conversation state lives in S3 so the agent stays stateless (Lambda-safe).
SESSION_BUCKET=

# --- Observability -----------------------------------------------------------
# Any OTLP endpoint. For Langfuse: https://<host>/api/public/otel
OTEL_EXPORTER_OTLP_ENDPOINT=
# For Langfuse: Authorization=Basic <base64 of public_key:secret_key>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=aiplat-agent
